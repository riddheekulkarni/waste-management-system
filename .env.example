# EcoClean Civic — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# Production rules:
#   - Never commit your actual .env file or real secrets to version control.
#   - In production (FLASK_ENV=production), SECRET_KEY and DATABASE_URL are
#     MANDATORY. If omitted or using default placeholders, the application
#     will fail to start with an explicit security configuration error.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application Environment ──────────────────────────────────────────────────
# Allowed values: development | production | testing
FLASK_ENV=development
PORT=5050

# ── Security & Authentication ────────────────────────────────────────────────
# In production: MUST be a high-entropy cryptographically random string
# (e.g. generated via: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-cryptographically-random-secret-key

# ── Database Layer ───────────────────────────────────────────────────────────
# Development: SQLite file (relative or absolute path)
DATABASE_URL=sqlite:///waste_management.db
# Production: PostgreSQL connection string
# DATABASE_URL=postgresql://<username>:<password>@<db-host>:5432/<dbname>

# ── Containerized PostgreSQL (used by docker-compose.yml) ────────────────────
POSTGRES_USER=ecoclean
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=ecoclean_civic_db

# ── AI Model Configuration ───────────────────────────────────────────────────
# Absolute path to trained YOLOv8 weights (e.g. /app/models/best.pt).
# If unset or missing, detector runs in MOCK_DEMO mode and clearly logs the reason.
WASTE_MODEL_WEIGHTS=
POTHOLE_MODEL_WEIGHTS=
MODEL_WEIGHTS_DIR=./models
# Optional directory containing YOLO results.csv and confusion_matrix.csv exports.
# Defaults to <project-root>/runs/waste_yolov8s.
YOLO_METRICS_DIR=

# ── Background Worker & Job Queue (Phase 3 Asynchronous Processing) ─────────
# Redis connection URL for RQ (Redis Queue)
REDIS_URL=redis://localhost:6379/0
# Async execution mode: 'redis' (production / Docker) | 'sync' (instant execution for tests)
ASYNC_MODE=redis
# Worker job timeout in seconds
JOB_TIMEOUT=180

# ── Upload Storage & Limits ──────────────────────────────────────────────────
# Maximum allowed payload size in megabytes (hard limit before parsing)
MAX_UPLOAD_MB=16

# ── Rate Limiting (Flask-Limiter) ─────────────────────────────────────────────
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=200 per day;50 per hour
# For production clusters with multiple workers, point to Redis:
# RATELIMIT_STORAGE_URL=redis://localhost:6379/0
RATELIMIT_STORAGE_URL=memory://

# ── Citizen Status Notifications ─────────────────────────────────────────────
# Options: log (default log-only) | smtp (Email) | sendgrid (SendGrid Web API)
NOTIFY_BACKEND=log

# SMTP Configuration (required when NOTIFY_BACKEND=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EcoClean Civic <no-reply@civic.gov>

# SendGrid Configuration (required when NOTIFY_BACKEND=sendgrid)
SENDGRID_API_KEY=

# ── Development Seeding (Optional) ───────────────────────────────────────────
# Overrides for demo user passwords created via `python seed.py`
DEMO_ADMIN_PASSWORD=admin123
DEMO_CITIZEN_PASSWORD=citizen123
# ALLOW_PRODUCTION_SEED=true  # Set ONLY if explicitly testing seed script in prod
