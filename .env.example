# EcoClean Civic Environment Configuration
SECRET_KEY=your-production-secret-key-change-me

# Database — leave as SQLite for local dev; swap to PostgreSQL for production
DATABASE_URL=sqlite:///waste_management.db
# DATABASE_URL=postgresql://ecoclean:ecoclean_pass@localhost:5432/ecoclean_db

# YOLOv8 model weights — leave blank to use the mock detector (demo mode).
# To enable real inference:
#   1. Run train_waste_yolov8.ipynb in Google Colab (see project root).
#   2. Download best.pt from your Google Drive.
#   3. Set the full absolute path below.
# Example: WASTE_MODEL_WEIGHTS=/home/user/models/best.pt
WASTE_MODEL_WEIGHTS=

FLASK_ENV=production
PORT=5050

# ── Citizen Notifications ──────────────────────────────────────────────────
# Choose a backend: smtp | sendgrid | log (default = log-only, no delivery)
NOTIFY_BACKEND=log

# SMTP (Gmail / any relay) — set NOTIFY_BACKEND=smtp to activate
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EcoClean Civic <your-app@gmail.com>

# SendGrid — set NOTIFY_BACKEND=sendgrid to activate
SENDGRID_API_KEY=
